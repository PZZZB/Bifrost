page{background:#111515;color:#e8eee9;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx;line-height:1.7}view,text,input,button{box-sizing:border-box}button::after{border:0}button[disabled]{opacity:.45}.page{padding:36rpx 32rpx 0}.brand{display:flex;align-items:center;gap:18rpx;border-bottom:1rpx solid #303b37;padding-bottom:32rpx;font-size:38rpx;font-weight:600}.brand-mark{display:flex;align-items:center;justify-content:center;color:#b5e5a4;width:62rpx;height:62rpx;border:1rpx solid #b5e5a440;border-radius:18rpx;background:#b5e5a412}.brand-caption{margin-left:auto;font-size:22rpx;color:#7f9287;font-weight:400}.intro{padding:55rpx 0 24rpx}.eyebrow{font-size:19rpx;font-weight:600;letter-spacing:3rpx;color:#7f9287}.title{font-size:56rpx;line-height:1.4;font-weight:600;margin:15rpx 0 20rpx}.muted{color:#a4b1a9}.small{font-size:22rpx}.spaced{margin-top:14rpx}.card{border:1rpx solid #303b37;background:#191e1e;border-radius:24rpx;padding:32rpx;margin-top:28rpx;min-width:0}.card-title{font-size:33rpx;font-weight:600;margin:9rpx 0 25rpx}.tabs{display:flex;gap:32rpx;border-bottom:1rpx solid #303b37;margin-bottom:30rpx}.tab{font-size:30rpx;color:#7f9287;line-height:1.6;border-radius:0;border-bottom:3rpx solid transparent;margin:0;padding:0 0 18rpx;background:transparent}.tab.selected{color:#b5e5a4;border-color:#b5e5a4}.field{margin-bottom:27rpx;min-width:0}.field>label{display:block;color:#a4b1a9;font-size:24rpx;margin-bottom:11rpx}input{background:#111716;border:1rpx solid #303b37;border-radius:14rpx;color:#e8eee9;font-size:29rpx;padding:18rpx 20rpx;height:86rpx;width:100%}.field>.small{margin-top:11rpx}.button{background:transparent;border:1rpx solid #303b37;border-radius:14rpx;color:#a4b1a9;font-size:26rpx;line-height:1.5;font-weight:600;padding:19rpx 24rpx;margin:0;min-height:78rpx}.primary{background:#b5e5a4;color:#1b2e18;border-color:#b5e5a4}.button.compact{width:auto;display:inline-block;font-size:23rpx;min-height:63rpx;padding:13rpx 22rpx}.button.danger{color:#ffb9a8;border-color:#ffb9a830;margin-top:20rpx}.notice{font-size:24rpx;padding:22rpx 25rpx;border:1rpx solid #303b37;border-radius:15rpx;margin-top:25rpx;word-break:break-all}.notice.error{color:#ffb9a8;border-color:#ffb9a825;background:#ffb9a807}.notice.success{color:#b5e5a4;border-color:#b5e5a42b;background:#b5e5a407}.heading{padding-top:42rpx;display:flex;align-items:flex-start;justify-content:space-between;gap:14rpx}.heading .title{font-size:49rpx;margin-bottom:9rpx}.heading-actions{display:flex;gap:9rpx;padding-top:20rpx}.heading .muted{font-size:23rpx;word-break:break-all}.code{font-family:monospace;word-break:break-all;white-space:pre-wrap;font-size:25rpx}.text-button{color:#b5e5a4;display:block;font-size:23rpx;text-align:left;background:transparent;border:0;padding:9rpx 0 0;margin:0;line-height:1.8;min-height:60rpx}.text-button.centered{text-align:center;margin-top:13rpx}.secret-card{border-color:#b5e5a44d;background:#1b2b1d}.secret{display:block;user-select:text;padding:25rpx 20rpx;background:#111716;border:1rpx solid #303b37;border-radius:12rpx;margin:25rpx 0;color:#d4efca}.count{font-size:21rpx;color:#7f9287;font-weight:400;margin-left:13rpx}.key-row,.model-row{border-top:1rpx solid #303b37;padding-top:26rpx;margin-top:25rpx}.key-title{display:flex;align-items:center;gap:14rpx;margin-bottom:10rpx;word-break:break-all;font-size:27rpx}.pill{font-size:20rpx;flex-shrink:0;border:1rpx solid #303b37;border-radius:25rpx;padding:1rpx 12rpx;color:#7f9287}.pill.active{color:#b5e5a4;border-color:#b5e5a42d;background:#b5e5a409}.pill.revoked,.pill.expired,.pill.disabled{color:#ffb9a8;border-color:#ffb9a82d}.empty{color:#7f9287;font-size:24rpx;padding:7rpx 0}.model-row>view:first-child{font-size:26rpx;word-break:break-all;margin-bottom:7rpx}.footer{border-top:1rpx solid #303b37;margin-top:45rpx;padding:25rpx 0 35rpx;font-size:20rpx;color:#7f9287}
