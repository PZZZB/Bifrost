{
  "name": "bifrost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A multi-channel model gateway for Codex and Claude, with subscription account routing, CodeBuddy, and Cursor integration.",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:foreground": "node src/main.mjs",
    "start:desktop": "node scripts/desktop.mjs start",
    "desktop": "node scripts/desktop.mjs",
    "start:claude-relay": "node scripts/run-claude-relay.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:payments": "node --test tests/payment-*.test.mjs",
    "test:wechat": "node --test tests/wechat-*.test.mjs tests/external-claude-gateway.test.mjs",
    "test:accounts": "node --test tests/email-address.test.mjs tests/web-accounts.test.mjs tests/wechat-*.test.mjs tests/external-claude-gateway.test.mjs",
    "verify:web-accounts": "node scripts/verify-web-accounts-offline.mjs",
    "verify:codex": "node scripts/verify-codex.mjs",
    "verify:desktop-codex": "node scripts/verify-desktop-codex-offline.mjs",
    "check": "node --check src/main.mjs && node --check public/app.js && node --check public/accounts/app.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.304",
    "@cursor/sdk": "1.0.40"
  }
}
