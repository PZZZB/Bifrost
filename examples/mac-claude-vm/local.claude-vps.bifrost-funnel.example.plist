<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>local.claude-vps.bifrost-funnel</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/sandbox-exec</string>
    <string>-f</string>
    <string>/Users/ACCOUNT/Library/Application Support/ClaudeVPS/Bifrost/External/funnel-loopback.sb</string>
    <string>/Users/ACCOUNT/Library/Application Support/ClaudeVPS/Bifrost/External/bin/tailscaled</string>
    <string>--tun=userspace-networking</string>
    <string>--state=/Users/ACCOUNT/Library/Application Support/ClaudeVPS/Bifrost/External/tailscale.state</string>
    <string>--statedir=/Users/ACCOUNT/Library/Application Support/ClaudeVPS/Bifrost/External/tailscale-data</string>
    <string>--socket=/Users/ACCOUNT/Library/Application Support/ClaudeVPS/Bifrost/External/tailscaled.sock</string>
    <string>--port=0</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>TS_FORCE_NOISE_443</key><string>true</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/ACCOUNT/Library/Application Support/ClaudeVPS/Bifrost/External/tailscaled.log</string>
  <key>StandardErrorPath</key><string>/Users/ACCOUNT/Library/Application Support/ClaudeVPS/Bifrost/External/tailscaled.log</string>
</dict></plist>
